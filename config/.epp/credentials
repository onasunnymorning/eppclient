# Sample configuration only. Replace every CHANGE_ME value before use.
# Go does not expand ~ in file paths, so use absolute certificate paths.

[default]
addr = epp.example.id:700
user = CHANGE_ME_CLIENT_ID
password = CHANGE_ME_PASSWORD
tls = true
cert = /home/CHANGE_ME_USERNAME/.epp/ssl/certificate.pem
key = /home/CHANGE_ME_USERNAME/.epp/ssl/certificate.key
ca = /home/CHANGE_ME_USERNAME/.epp/ssl/certificate.pem

[sandbox]
addr = epp.sandbox.example.id:700
user = CHANGE_ME_SANDBOX_CLIENT_ID
password = CHANGE_ME_SANDBOX_PASSWORD
tls = true
cert = /home/CHANGE_ME_USERNAME/.epp/ssl/certificate.pem
key = /home/CHANGE_ME_USERNAME/.epp/ssl/certificate.key
ca = /home/CHANGE_ME_USERNAME/.epp/ssl/certificate.pem
